<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md max-w-2xl">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Reserve <%= home.houseName %></h1>

      <div class="flex flex-col md:flex-row gap-6 mb-6">
        <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full md:w-1/2 h-56 object-cover rounded-lg">
        <div>
          <p class="text-gray-600 mb-2"><i class="fas fa-map-marker-alt mr-2"></i><%= home.location %></p>
          <p class="text-lg font-bold text-red-500 mb-2">Rs<%= home.price %> / night</p>
          <div class="flex items-center">
            <span class="text-yellow-400 text-xl">★</span>
            <span class="ml-2 text-gray-700"><%= home.rating %> / 5</span>
          </div>
        </div>
      </div>

      <%- include('../partials/errors') %>

      <form action="/bookings" method="POST" class="max-w-md mx-auto">
        <input type="hidden" name="homeId" value="<%= home._id %>" />

        <label class="block text-gray-700 mb-1">Check-In Date</label>
        <input
          type="date"
          name="checkInDate"
          value="<%= oldInput.checkInDate %>"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>

        <label class="block text-gray-700 mb-1">Check-Out Date</label>
        <input
          type="date"
          name="checkOutDate"
          value="<%= oldInput.checkOutDate %>"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>

        <input type="submit" value="Confirm Booking" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300" />
      </form>
    </main>
  </body>
</html>
