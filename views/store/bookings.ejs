<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        My Bookings
      </h2>
      <% if (bookings.length === 0) { %>
        <p class="text-2xl text-gray-700 text-center mb-8">Bookings will appear here</p>
      <% } else { %>
      <div class="flex flex-wrap justify-center gap-6">
        <% bookings.forEach(booking => { %>
          <% if (booking.home) { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300 w-full max-w-sm">
            <img src="<%= photoUrl(booking.home.photo) %>" alt="<%= booking.home.houseName %>" class="w-full h-48 object-cover">
            <div class="p-4">
              <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= booking.home.houseName %></h3>
              <p class="text-gray-600 mb-2"><i class="fas fa-map-marker-alt mr-2"></i><%= booking.home.location %></p>
              <p class="text-gray-600 mb-2">
                <%= booking.checkInDate.toDateString() %> - <%= booking.checkOutDate.toDateString() %>
              </p>
              <p class="text-gray-600 mb-2"><%= booking.totalNights %> night<%= booking.totalNights > 1 ? 's' : '' %></p>
              <div class="flex justify-between items-center mb-2">
                <span class="text-lg font-bold text-red-500">Rs<%= booking.totalPrice %> total</span>
              </div>
              <form action="/bookings/delete/<%= booking._id %>" method="POST">
                <button class="w-full bg-red-600 text-white px-4 py-2 rounded-md font-medium shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition duration-200" type="submit">Cancel Booking</button>
              </form>
            </div>
          </div>
          <% } %>
        <% }) %>
      </div>
      <% } %>
    </main>
  </body>
</html>
